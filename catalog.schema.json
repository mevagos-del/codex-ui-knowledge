{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mevagos-del/codex-ui-knowledge/catalog.schema.json",
  "title": "Codex UI Knowledge catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "patterns"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 2 },
    "patterns": {
      "type": "array",
      "items": { "$ref": "#/$defs/pattern" }
    }
  },
  "$defs": {
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "path", "categories", "tags", "source", "license",
        "production", "complexity", "performance", "mobile", "reducedMotion",
        "techniques", "browserNotes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+/$"
        },
        "categories": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "url", "adaptation"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "url": { "type": "string", "format": "uri" },
            "revision": { "type": "string", "minLength": 1 },
            "adaptation": { "enum": ["copied", "adapted", "reimplemented"] }
          }
        },
        "license": { "type": "string", "minLength": 1 },
        "production": { "enum": ["recommended", "conditional", "experimental"] },
        "complexity": { "enum": ["low", "medium", "high"] },
        "performance": { "enum": ["excellent", "good", "medium", "expensive"] },
        "mobile": { "enum": ["safe", "fallback", "avoid"] },
        "reducedMotion": { "type": "boolean" },
        "techniques": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "browserNotes": { "type": "string" }
      }
    }
  }
}
