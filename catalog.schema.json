{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mevagos-del/codex-ui-knowledge/catalog.schema.json",
  "title": "Codex UI Knowledge catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "patterns"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 2 },
    "patterns": {
      "type": "array",
      "items": { "$ref": "#/$defs/pattern" }
    }
  },
  "$defs": {
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "path", "categories", "tags", "package", "source", "license",
        "production", "complexity", "performance", "mobile", "reducedMotion",
        "techniques", "browserNotes", "useCases", "visualIntensity",
        "contentDensity", "interactionPriority", "adaptability", "risk"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+/$"
        },
        "categories": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "stylesheet", "scope"],
          "properties": {
            "type": { "enum": ["pattern", "tokens"] },
            "stylesheet": { "enum": ["style.css", "tokens.css"] },
            "scope": { "type": "string", "pattern": "^(?:\\.[a-z][a-z0-9-]*|:where\\(\\.[a-z][a-z0-9-]*\\))$" }
          },
          "allOf": [
            {
              "if": { "properties": { "type": { "const": "pattern" } } },
              "then": { "properties": { "stylesheet": { "const": "style.css" } } }
            },
            {
              "if": { "properties": { "type": { "const": "tokens" } } },
              "then": { "properties": { "stylesheet": { "const": "tokens.css" } } }
            }
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "url", "adaptation"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "url": { "type": "string", "format": "uri" },
            "revision": { "type": "string", "minLength": 1 },
            "adaptation": { "enum": ["copied", "adapted", "reimplemented"] }
          }
        },
        "license": { "type": "string", "minLength": 1 },
        "production": { "enum": ["recommended", "conditional", "experimental"] },
        "complexity": { "enum": ["low", "medium", "high"] },
        "performance": { "enum": ["excellent", "good", "medium", "expensive"] },
        "mobile": { "enum": ["safe", "fallback", "avoid"] },
        "reducedMotion": { "type": "boolean" },
        "techniques": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "browserNotes": { "type": "string" },
        "useCases": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "minItems": 1,
          "uniqueItems": true
        },
        "visualIntensity": { "enum": ["low", "medium", "high"] },
        "contentDensity": { "enum": ["low", "medium", "high"] },
        "interactionPriority": { "enum": ["primary", "secondary", "decorative", "none"] },
        "adaptability": { "enum": ["high", "medium", "low"] },
        "risk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accessibility", "performance", "compatibility"],
          "properties": {
            "accessibility": { "enum": ["low", "medium", "high"] },
            "performance": { "enum": ["low", "medium", "high"] },
            "compatibility": { "enum": ["low", "medium", "high"] }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["continuous", "trigger"],
          "properties": {
            "continuous": { "type": "boolean" },
            "trigger": { "enum": ["interaction", "enter", "exit", "attention", "transition"] }
          }
        }
      }
    }
  }
}
